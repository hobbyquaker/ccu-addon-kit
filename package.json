{
  "name": "ccu-addon-kit",
  "version": "0.1.0-dev",
  "description": "The shared settings frame, Tcl CGI library and service convention for classic Homematic CCU addons (CCU3, OpenCCU), and the Go side for openccu-lite",
  "license": "MIT",
  "author": "Sebastian Raff <hobbyquaker@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hobbyquaker/ccu-addon-kit.git"
  },
  "homepage": "https://github.com/hobbyquaker/ccu-addon-kit#readme",
  "bugs": "https://github.com/hobbyquaker/ccu-addon-kit/issues",
  "keywords": [
    "homematic",
    "ccu",
    "ccu3",
    "openccu",
    "addon",
    "tcl",
    "svelte"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "ccu-addon-kit": "cli/index.mjs"
  },
  "exports": {
    "./frame": {
      "types": "./frame/src/index.ts",
      "svelte": "./frame/src/index.ts",
      "default": "./frame/src/index.ts"
    },
    "./vite": {
      "types": "./vite/index.d.ts",
      "default": "./vite/index.mjs"
    },
    "./schema/*": "./schema/*",
    "./package.json": "./package.json"
  },
  "files": [
    "cli/",
    "classic/",
    "frame/src/",
    "vite/",
    "schema/",
    "docs/",
    "example/kitdemo/",
    "!example/kitdemo/web/dist/",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "test": "node --test test/cli/*.test.mjs",
    "test:tcl": "node --test test/tcl/*.test.mjs",
    "test:sh": "sh test/sh/kit-run.test.sh",
    "lint:tcl": "node test/tcl/lint-tcl82.mjs",
    "gate": "sh test/gate.sh",
    "test:frame": "vitest run --config frame/vitest.config.ts",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "build:kitdemo": "vite build --config example/kitdemo/web/vite.config.mjs",
    "size": "node test/frame/size.mjs",
    "test:pw": "playwright test --config test/frame/playwright.config.mjs"
  },
  "peerDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "occulite-ui": "^0.1.0",
    "svelte": "^5.40.0",
    "vite": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "occulite-ui": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "@sveltejs/vite-plugin-svelte": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/node": "^26.6.5",
    "jsdom": "^30.1.3",
    "occulite-ui": "^0.1.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^5.0.5"
  }
}

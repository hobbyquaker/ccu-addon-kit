{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true
  },
  "include": ["frame/src/**/*.ts", "frame/src/**/*.svelte", "frame/test/**/*.ts", "example/kitdemo/web/src/**/*.ts", "example/kitdemo/web/src/**/*.svelte"]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hobbyquaker/ccu-addon-kit/schema/kit.schema.json",
  "title": "ccu-addon-kit kit.json",
  "description": "An addon's kit configuration; ccu-addon-kit vendor generates lib/kit/addon.tcl and www/frame/addon.json from it (docs/cgi-api.md).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "name", "tabs"],
  "$defs": {
    "i18n": {"type": "object", "required": ["de", "en"], "properties": {"de": {"type": "string", "minLength": 1}, "en": {"type": "string", "minLength": 1}}},
    "path": {"type": "string", "pattern": "^/"},
    "level": {"enum": ["any", "user", "admin"]}
  },
  "properties": {
    "$schema": {"type": "string"},
    "schema": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,31}$", "description": "the /addons/<id>/ path and the rc.d name"},
    "www": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,31}$", "description": "the directory of the settings frame and its CGIs: /addons/<www>/settings.cgi is the Config-Url; default the id, another name when the addon's own app is proxied at /addons/<id>/ (RedMatic: app /addons/red/, settings /addons/redmatic/)"},
    "name": {"$ref": "#/$defs/i18n"},
    "icon": {"type": "string", "description": "a path relative to the addon's www/"},
    "addonDir": {"$ref": "#/$defs/path", "description": "default /usr/local/addons/<id>"},
    "rc": {"$ref": "#/$defs/path", "description": "default /usr/local/etc/config/rc.d/<id>"},
    "versionFile": {"$ref": "#/$defs/path", "description": "default <addonDir>/versions"},
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "commands": {"type": "array", "uniqueItems": true, "items": {"enum": ["start", "stop", "restart", "reload"]}},
        "pollSeconds": {"type": "integer", "minimum": 2, "maximum": 300}
      }
    },
    "logs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "label": {"$ref": "#/$defs/i18n"},
          "file": {"$ref": "#/$defs/path"},
          "rotated": {"$ref": "#/$defs/path"},
          "syslogTag": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,32}$"}
        },
        "oneOf": [{"required": ["file"]}, {"required": ["syslogTag"]}]
      }
    },
    "update": {
      "type": "object",
      "additionalProperties": false,
      "required": ["github"],
      "properties": {
        "github": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "assetHint": {"type": "string"}
      }
    },
    "permissions": {
      "description": "default: any valid session may do everything; \"levels\" is the opt-in table read: user, service/log/write: admin",
      "oneOf": [
        {"const": "levels"},
        {"type": "object", "additionalProperties": false,
          "properties": {"read": {"$ref": "#/$defs/level"}, "service": {"$ref": "#/$defs/level"}, "log": {"$ref": "#/$defs/level"}, "write": {"$ref": "#/$defs/level"}}}
      ]
    },
    "tabs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"anyOf": [{"enum": ["kit:service", "kit:log", "kit:about"]}, {"type": "string", "pattern": "^(?!kit)[a-z0-9][a-z0-9-]*$"}]}
    },
    "liteTabs": {
      "description": "the tabs shown inside openccu-lite's shell (where service control and the log are the shell's own pages); a subset of tabs, in order; default: tabs",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "proxied": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": {"type": "string", "pattern": "^/addons/.*/$", "description": "below /addons/<id>/, ending with /; must not hide the frame's /addons/<www>/"},
        "errorPage": {"type": "boolean", "description": "install the 503 page shown while the server is down"},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535, "description": "the server's port on 127.0.0.1: vendor writes etc/lighttpd.conf (the proxy rule, the redirect of the path without its slash, the 503 page)"},
        "websocket": {"type": "boolean", "description": "pass WebSocket upgrades (default true)"}
      }
    },
    "app": {
      "description": "The addon's own web application, served by its backend (e.g. behind a lighttpd proxy rule): the frame shows a prominent button that opens it in a new window, the session handed over as the WebUI hands it to the settings page",
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "label"],
      "properties": {"path": {"type": "string", "pattern": "^/addons/"}, "label": {"$ref": "#/$defs/i18n"}}
    },
    "links": {
      "type": "array",
      "items": {"type": "object", "required": ["label", "url"], "properties": {"label": {"$ref": "#/$defs/i18n"}, "url": {"type": "string", "pattern": "^https?://"}}}
    }
  }
}
